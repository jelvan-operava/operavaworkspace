# Server-side Gemini AI Assistant key (required for /api/gemini/generate).
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# Do NOT prefix with NEXT_PUBLIC_ — this must stay server-only.
GEMINI_API_KEY=

# ── Supabase (Auth, DB, Realtime, Storage) ─────────────────────────────
# Create a project at https://supabase.com/dashboard → Settings → API
# Local: run `npx supabase start` then copy URL/keys from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server-only service role (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
