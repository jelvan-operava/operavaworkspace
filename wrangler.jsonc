{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operava-desk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Secrets: use `wrangler secret put GEMINI_API_KEY` (or Cloudflare Dashboard).
  // Do not put real secrets here. Local preview: `.dev.vars` (gitignored).
  "vars": {
    "APP_NAME": "operava-desk",
    "APP_ENV": "production"
  },
  // Provision once (see scripts/cf-setup.md), then paste real IDs below.
  // Until then, local `wrangler dev` / Miniflare can still simulate bindings.
  "kv_namespaces": [
    {
      "binding": "PORTAL_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "PORTAL_DB",
      "database_name": "operava-desk",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "preview_database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PORTAL_FILES",
      "bucket_name": "operava-desk-files",
      "preview_bucket_name": "operava-desk-files-preview"
    }
  ]
}
